{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "watermark-cleaner",
  "version": "0.4.2",
  "identifier": "com.yazhouzou.doubaoWatermarkRemover",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "图片水印清理助手",
        "width": 1080,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}